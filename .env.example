# Public URL of this CodeLink deployment (no trailing slash)
APP_URL=http://localhost:3000

# Supabase project (Settings > API). The service role key stays server-side only.
SUPABASE_URL=https://YOUR-PROJECT.supabase.co
SUPABASE_SERVICE_ROLE_KEY=

# GitHub OAuth App (github.com/settings/developers)
# Callback URL: {APP_URL}/api/auth/github/callback
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=

# Any long random strings, e.g. `openssl rand -base64 48`
SESSION_SECRET=
ENCRYPTION_KEY=
